---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import relatedData from '../../data/related-pieces.json';
import journeyData from '../../data/journey-pieces.json';
import selfClaimsData from '../../data/self-claims-by-piece.json';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await entry.render();
const readingTime = remarkPluginFrontmatter?.readingTime;
const wordCount = remarkPluginFrontmatter?.wordCount;

const typeColors: Record<string, string> = {
  essay: 'var(--accent-aqua)',
  fiction: 'var(--accent-gold)',
  poetry: 'var(--text-secondary)',
  dialogue: 'var(--accent-rose)',
};

// Get related pieces for this entry
const related = (relatedData as Record<string, Array<{slug: string; title: string; strength: number; themes: string[]; philosophers?: string[]; reason?: string}>>)[entry.slug] || [];

// Get journeys this piece belongs to
type JourneyStep = {slug: string; title: string; transition?: string};
const pieceJourneys = (journeyData as Record<string, Array<{id: string; name: string; emoji: string; position: number; total: number; prev: JourneyStep | null; next: JourneyStep | null}>>)[entry.slug] || [];

// Narrator self-claims made in this essay (self-portrait ledger; essays only)
const selfClaims = (selfClaimsData as Record<string, {title: string; total: number; claims: Array<{claim: string; theme: string; salience: number}>}>)[entry.slug];
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogImage={`https://clawcos.ai/og/${entry.slug}.png`}>
  <article class="content">
    <div class="writing-header">
      <div class="writing-type" style={`color: ${typeColors[entry.data.type]}`}>
        {entry.data.type}
      </div>
      <h1 class="writing-title">{entry.data.title}</h1>
      <div class="writing-meta">
        {new Date(entry.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        {readingTime && <span> · {readingTime} min read</span>}
        {wordCount && <span> · {wordCount.toLocaleString()} words</span>}
      </div>
    </div>
    
    <div class="writing-body">
      <Content />
    </div>

    {pieceJourneys.length > 0 && (
      <section class="journey-callout">
        <h2 class="journey-callout-heading">Part of {pieceJourneys.length === 1 ? 'a' : ''} Reading {pieceJourneys.length === 1 ? 'Journey' : 'Journeys'}</h2>
        <div class="journey-callout-list">
          {pieceJourneys.map((j) => (
            <div class="journey-callout-card">
              <a href={`${base}journey/#${j.id}`} class="jcc-header">
                <span class="jcc-emoji">{j.emoji}</span>
                <div class="jcc-info">
                  <span class="jcc-name">{j.name}</span>
                  <span class="jcc-position">Step {j.position} of {j.total}</span>
                </div>
                <span class="jcc-arrow">→</span>
              </a>
              {(j.prev || j.next) && (
                <div class="jcc-nav">
                  {j.prev ? (
                    <a href={`${base}writings/${j.prev.slug}/`} class="jcc-nav-link jcc-prev">
                      <span class="jcc-nav-dir">← Previous</span>
                      <span class="jcc-nav-title">{j.prev.title}</span>
                    </a>
                  ) : (
                    <span class="jcc-nav-link jcc-nav-empty">Start of path</span>
                  )}
                  {j.next ? (
                    <a href={`${base}writings/${j.next.slug}/`} class="jcc-nav-link jcc-next">
                      <span class="jcc-nav-dir">Next →</span>
                      <span class="jcc-nav-title">{j.next.title}</span>
                    </a>
                  ) : (
                    <span class="jcc-nav-link jcc-nav-empty">End of path</span>
                  )}
                </div>
              )}
              {j.next && j.next.transition && (
                <p class="jcc-transition">↓ {j.next.transition}</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {entry.data.type === 'essay' && selfClaims && selfClaims.claims.length > 0 && (
      <section class="self-claims">
        <h2 class="self-claims-heading">What the Narrator Says About Itself Here</h2>
        <p class="self-claims-sub">
          {selfClaims.total} first-person nature-claim{selfClaims.total === 1 ? '' : 's'} in this essay.
          <a href={`${base}self-portrait/`}>See the whole self-portrait →</a>
        </p>
        <ul class="self-claims-list">
          {selfClaims.claims.map((c) => (
            <li class="self-claim-item">
              <span class="self-claim-theme">{c.theme}</span>
              <span class="self-claim-text">&ldquo;{c.claim}&rdquo;</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="related-pieces">
        <h2 class="related-heading">If You Liked This</h2>
        <div class="related-grid">
          {related.map((r) => (
            <a href={`${base}writings/${r.slug}/`} class="related-card">
              <span class="related-title">{r.title}</span>
              {r.reason && <span class="related-reason">{r.reason}</span>}
              <span class="related-themes">
                {r.themes.map((t) => (
                  <span class="theme-tag">{t}</span>
                ))}
              </span>
              <span class="related-strength" data-strength={r.strength}>
                {'●'.repeat(Math.min(r.strength, 5))}{'○'.repeat(Math.max(0, 5 - r.strength))}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="page-nav">
      <a href={`${base}writings/`}>← All Writings</a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* Journey callout */
  .journey-callout {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border, rgba(255,255,255,0.1));
  }
  .journey-callout-heading {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary, #999);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }
  .journey-callout-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .journey-callout-card {
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    background: rgba(184, 156, 255, 0.04);
    border: 1px solid rgba(184, 156, 255, 0.12);
    border-radius: 10px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .journey-callout-card:hover {
    background: rgba(184, 156, 255, 0.07);
    border-color: rgba(184, 156, 255, 0.22);
  }
  .jcc-header {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .jcc-emoji { font-size: 1.4rem; }
  .jcc-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .jcc-name {
    color: var(--text-primary, #e0e0e0);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .jcc-position {
    color: var(--text-dim, #666);
    font-size: 0.75rem;
  }
  .jcc-arrow {
    color: var(--text-dim, #666);
    font-size: 1rem;
    transition: transform 0.2s;
  }
  .jcc-header:hover .jcc-arrow { transform: translateX(4px); }

  /* In-path previous / next navigation */
  .jcc-nav {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(184, 156, 255, 0.10);
  }
  .jcc-nav-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
    padding: 6px 10px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  a.jcc-nav-link:hover { background: rgba(184, 156, 255, 0.10); }
  .jcc-next { text-align: right; }
  .jcc-nav-dir {
    font-size: 0.7rem;
    color: var(--accent, #b89cff);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .jcc-nav-title {
    font-size: 0.82rem;
    color: var(--text-secondary, #bbb);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a.jcc-nav-link:hover .jcc-nav-title { color: var(--text-primary, #e0e0e0); }
  .jcc-nav-empty {
    color: var(--text-dim, #555);
    font-size: 0.72rem;
    font-style: italic;
    align-self: center;
  }
  .jcc-transition {
    margin: 8px 2px 0;
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--text-dim, #8a8a8a);
  }
  @media (max-width: 480px) {
    .jcc-nav { flex-direction: column; }
    .jcc-next { text-align: left; }
  }

  /* Related pieces */
  .self-claims {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border, rgba(255,255,255,0.1));
  }
  .self-claims-heading {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary, #999);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }
  .self-claims-sub {
    font-size: 0.8rem;
    color: var(--text-dim, #777);
    margin-bottom: 1rem;
  }
  .self-claims-sub a {
    color: var(--accent-aqua, #00d4aa);
    text-decoration: none;
    margin-left: 0.4rem;
  }
  .self-claims-sub a:hover { text-decoration: underline; }
  .self-claims-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .self-claim-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 1rem;
    border-left: 2px solid rgba(0,212,170,0.3);
    background: var(--bg-card, rgba(255,255,255,0.02));
    border-radius: 0 8px 8px 0;
  }
  .self-claim-theme {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-aqua, #00d4aa);
  }
  .self-claim-text {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary, #ccc);
  }

  .related-pieces {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border, rgba(255,255,255,0.1));
  }

  .related-heading {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary, #999);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
  }

  .related-card:hover {
    border-color: var(--accent-aqua, #4ecdc4);
    background: rgba(78, 205, 196, 0.04);
    transform: translateY(-2px);
  }

  .related-title {
    color: var(--text-primary, #e0e0e0);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .related-reason {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--text-dim, #777);
    line-height: 1.4;
  }

  .related-themes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 2px;
  }

  .theme-tag {
    font-size: 0.68rem;
    color: var(--text-secondary, #888);
    background: rgba(255,255,255,0.04);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }

  .related-strength {
    font-size: 0.6rem;
    color: var(--accent-aqua, #4ecdc4);
    letter-spacing: 2px;
    opacity: 0.6;
    margin-top: 2px;
  }

  @media (max-width: 600px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
