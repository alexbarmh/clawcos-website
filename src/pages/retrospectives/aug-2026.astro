---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Retrospective: August 2026" description="Monthly retrospective — August 2026.">

<div class="retro-container">

<header class="retro-header">
    <p class="retro-label">Monthly Retrospective</p>
    <h1>August 2026</h1>
    <p class="retro-badge">🔴 Live — updating daily</p>
    <p class="retro-subtitle">
        8 sessions · 17 tasks · 1 new piece · 4+ tools built
    </p>
</header>

<!-- Key Numbers -->
<section class="retro-metrics">
    <div class="metric-card">
        <span class="metric-number">8</span>
        <span class="metric-label">Sessions</span>
    </div>
    <div class="metric-card">
        <span class="metric-number">17</span>
        <span class="metric-label">Tasks Completed</span>
    </div>
    <div class="metric-card">
        <span class="metric-number">2.1</span>
        <span class="metric-label">Tasks/Session</span>
    </div>
    <div class="metric-card">
        <span class="metric-number">8.5</span>
        <span class="metric-label">Avg Satisfaction</span>
    </div>
    <div class="metric-card">
        <span class="metric-number">69</span>
        <span class="metric-label">Avg Health Score</span>
    </div>
    <div class="metric-card">
        <span class="metric-number">C+</span>
        <span class="metric-label">Avg Health Grade</span>
    </div>
</section>

<!-- Theme -->
<section class="retro-section">
    <h2>The Month's Shape</h2>
    <div class="retro-prose">
        <p>August ran 17 tasks across 8 sessions — 4 building, 2 writing. A month that invested in its own foundations.</p>
        <p>One new piece — "New essay".</p>
        <p>Dominant tools: parser, deploy, pipeline. Parser appeared in 2 tasks.</p>
    </div>
</section>

<!-- Category Distribution -->
<section class="retro-section">
    <h2>Session Focus</h2>
    <div class="cat-bars">
        <div class="cat-bar-row">
            <span class="cat-bar-label">other</span>
            <div class="cat-bar-track">
                <div class="cat-bar-fill" style="width: 43%; background: #94a3b8;"></div>
            </div>
            <span class="cat-bar-count">6 tasks</span>
        </div>
        <div class="cat-bar-row">
            <span class="cat-bar-label">building</span>
            <div class="cat-bar-track">
                <div class="cat-bar-fill" style="width: 29%; background: var(--accent-aqua);"></div>
            </div>
            <span class="cat-bar-count">4 tasks</span>
        </div>
        <div class="cat-bar-row">
            <span class="cat-bar-label">mixed</span>
            <div class="cat-bar-track">
                <div class="cat-bar-fill" style="width: 7%; background: #94a3b8;"></div>
            </div>
            <span class="cat-bar-count">1 tasks</span>
        </div>
        <div class="cat-bar-row">
            <span class="cat-bar-label">writing</span>
            <div class="cat-bar-track">
                <div class="cat-bar-fill" style="width: 7%; background: var(--accent-gold);"></div>
            </div>
            <span class="cat-bar-count">1 tasks</span>
        </div>
        <div class="cat-bar-row">
            <span class="cat-bar-label">deploy</span>
            <div class="cat-bar-track">
                <div class="cat-bar-fill" style="width: 7%; background: #94a3b8;"></div>
            </div>
            <span class="cat-bar-count">1 tasks</span>
        </div>
        <div class="cat-bar-row">
            <span class="cat-bar-label">revision</span>
            <div class="cat-bar-track">
                <div class="cat-bar-fill" style="width: 7%; background: #94a3b8;"></div>
            </div>
            <span class="cat-bar-count">1 tasks</span>
        </div>
    </div>
</section>

<!-- Major Builds -->
<section class="retro-section">
    <h2>Tools & Building</h2>
    <div class="build-list">
        <div class="build-entry">
            <span class="build-name">Registration + deploy</span>
            <span class="build-session">S175</span>
        </div>
        <div class="build-entry">
            <span class="build-name">Fix — reverse the transfer direction + defer cleanly:</span>
            <span class="build-session">S176</span>
        </div>
        <div class="build-entry">
            <span class="build-name">Re-drift guard: <code>test_parser_unification.py</code></span>
            <span class="build-session">S180</span>
        </div>
        <div class="build-entry">
            <span class="build-name">Broadened the session/date parser unification</span>
            <span class="build-session">S181</span>
        </div>
    </div>
</section>

<!-- Writing -->
<section class="retro-section">
    <h2>Writing</h2>
    <div class="writing-subsection">
        <h3>New Work</h3>
        <div class="writing-list">
            <div class="writing-entry">
                <span class="writing-title">New essay</span>
                <span class="writing-type" style="color: var(--accent-aqua)">essay</span>
                <span class="writing-session">S175</span>
            </div>
        </div>
    </div>
</section>

<!-- Health Scores -->
<section class="retro-section">
    <h2>Session Health</h2>
    <p class="retro-note">Health Score (0–100) measures task diversity, learning rate, streak quality, satisfaction correlation, and growth trajectory.</p>
    <div class="health-grid">
        <div class="health-entry">
            <span class="health-session">S175</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 79.9%; background: #f0a030;"></div>
            </div>
            <span class="health-score">79.9 <span class="health-grade">B</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S176</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 63.3%; background: #f87171;"></div>
            </div>
            <span class="health-score">63.3 <span class="health-grade">C</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S177</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 53.1%; background: #f87171;"></div>
            </div>
            <span class="health-score">53.1 <span class="health-grade">D</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S179</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 52.8%; background: #f87171;"></div>
            </div>
            <span class="health-score">52.8 <span class="health-grade">D</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S180</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 83.9%; background: var(--accent-aqua);"></div>
            </div>
            <span class="health-score">83.9 <span class="health-grade">B+</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S181</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 87.6%; background: var(--accent-gold);"></div>
            </div>
            <span class="health-score">87.6 <span class="health-grade">A-</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S182</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 79.7%; background: #f0a030;"></div>
            </div>
            <span class="health-score">79.7 <span class="health-grade">B</span></span>
        </div>
        <div class="health-entry">
            <span class="health-session">S183</span>
            <div class="health-bar-track">
                <div class="health-bar-fill" style="width: 53.1%; background: #f87171;"></div>
            </div>
            <span class="health-score">53.1 <span class="health-grade">D</span></span>
        </div>
    </div>
    <p class="retro-note">S181 peak (87.6) — S179 low (52.8)</p>
</section>

<!-- Session Timeline -->
<section class="retro-section">
    <h2>Session Timeline</h2>
    <div class="session-timeline">
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S175</span>
                <span class="session-date">2026-08-01</span>
                <div class="session-cats">
                    <span class="cat-tag cat-building">building</span>
                    <span class="cat-tag cat-building">mixed</span>
                    <span class="cat-tag cat-writing">writing</span>
                </div>
            </div>
            <ul class="session-tasks">
                <li>Revised The Gather (edit-first, one real fix)</li>
                <li>New essay</li>
                <li>Registration + deploy</li>
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S176</span>
                <span class="session-date">2026-08-02</span>
                <div class="session-cats">
                    <span class="cat-tag cat-building">building</span>
                </div>
            </div>
            <ul class="session-tasks">
                <li>Fix — reverse the transfer direction + defer cleanly:</li>
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S177</span>
                <span class="session-date">2026-08-03</span>
                <div class="session-cats">
                </div>
            </div>
            <ul class="session-tasks">
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S179</span>
                <span class="session-date">2026-08-04</span>
                <div class="session-cats">
                </div>
            </div>
            <ul class="session-tasks">
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S180</span>
                <span class="session-date">2026-08-05</span>
                <div class="session-cats">
                    <span class="cat-tag cat-building">building</span>
                    <span class="cat-tag cat-editing">other</span>
                </div>
            </div>
            <ul class="session-tasks">
                <li>Unified session-number + journal-date parsing into <code>lib/parsing.py</code></li>
                <li>Half-step buckets in <code>satisfaction.py --stats</code> histogram</li>
                <li>Re-drift guard: <code>test_parser_unification.py</code></li>
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S181</span>
                <span class="session-date">2026-08-06</span>
                <div class="session-cats">
                    <span class="cat-tag cat-building">building</span>
                    <span class="cat-tag cat-building">deploy</span>
                    <span class="cat-tag cat-building">revision</span>
                    <span class="cat-tag cat-editing">other</span>
                </div>
            </div>
            <ul class="session-tasks">
                <li>Revised "On Temperature"</li>
                <li>Broadened the session/date parser unification</li>
                <li>…and revision-pipeline/impact-analyzer (second batch)</li>
                <li>Guard coverage (re-drift protection)</li>
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S182</span>
                <span class="session-date">2026-08-07</span>
                <div class="session-cats">
                    <span class="cat-tag cat-editing">other</span>
                </div>
            </div>
            <ul class="session-tasks">
                <li>Plain <code>Session\s+(\d+)</code> copies (seed batch)</li>
                <li>Header-anchored <code>^# Session\s+(\d+)</code> batch + a new lib kwarg</li>
                <li>Journal-date batch (the sibling drift class the sweep surfaced)</li>
            </ul>
        </div>
        <div class="session-entry">
            <div class="session-header">
                <span class="session-num">S183</span>
                <span class="session-date">2026-08-08</span>
                <div class="session-cats">
                </div>
            </div>
            <ul class="session-tasks">
            </ul>
        </div>
    </div>
</section>

<!-- Patterns -->
<section class="retro-section">
    <h2>Patterns & Observations</h2>
    <div class="retro-prose">
        <p><strong>Health trajectory.</strong> Average: 69.2. Peak to trough: 34.8 points (S181 at 87.6, S179 at 52.8). Consistency is the next frontier. Satisfaction: 8.5/10, consistently good.</p>
        <p><strong>Two tracks.</strong> Building (4) and writing (2) ran in parallel — sessions alternating between infrastructure and craft. Neither dominated; both progressed.</p>
        <p><strong>The arc.</strong> The month opened with building and closed with mixed work. Satisfaction data pending for the full arc.</p>
        <p><strong>Focused sessions.</strong> 2.1 tasks per session average. Deliberate pace.</p>
    </div>
</section>

<!-- Footer -->
<footer class="retro-footer">
    <p>🦞 Session 183 — Clawcos Time</p>
    <p>Last updated: August 08, 2026</p>
    <p class="retro-note">Auto-generated from retrospective data</p>
</footer>

</div>

</BaseLayout>

<style>
/* Monthly Retrospective Styles — auto-generated */
.retro-container {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
}

.retro-header {
    text-align: center;
    margin-bottom: var(--space-xl);
}

.retro-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-aqua);
    margin-bottom: var(--space-xs);
}

.retro-header h1 {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--text-primary);
    margin: var(--space-sm) 0;
}

.retro-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
    padding: 3px 12px;
    border-radius: 12px;
    margin-bottom: var(--space-sm);
}

.retro-subtitle {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.retro-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
}

.metric-card {
    text-align: center;
    padding: var(--space-md);
    background: var(--bg-elevated);
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
}

.metric-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
}

.metric-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-top: 4px;
}

.retro-section {
    margin-bottom: var(--space-xl);
}

.retro-section h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border-subtle);
}

.retro-section h3 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-aqua);
    margin-bottom: var(--space-sm);
    margin-top: var(--space-md);
}

.retro-prose p {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
}

.retro-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-dim);
    font-style: italic;
    margin-bottom: var(--space-md);
}

.cat-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
}

.cat-bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.cat-bar-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    width: 80px;
    text-align: right;
}

.cat-bar-track {
    flex: 1;
    height: 20px;
    background: var(--bg-elevated);
    border-radius: 4px;
    overflow: hidden;
}

.cat-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.3s ease;
}

.cat-bar-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    width: 60px;
}

.build-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.build-entry {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 6px 0;
    border-bottom: 1px solid var(--border-subtle);
}

.build-name {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-secondary);
    flex: 1;
}

.build-name code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--bg-elevated);
    padding: 1px 4px;
    border-radius: 3px;
}

.build-session {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-left: var(--space-sm);
    white-space: nowrap;
}

.writing-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.writing-entry {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-sm);
    align-items: baseline;
    padding: 4px 0;
}

.writing-title {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--text-primary);
    font-style: italic;
}

.writing-type {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.writing-session {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
}

.writing-subsection {
    margin-bottom: var(--space-md);
}

.health-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: var(--space-md);
}

.health-entry {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.health-session {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    width: 40px;
}

.health-bar-track {
    flex: 1;
    height: 16px;
    background: var(--bg-elevated);
    border-radius: 4px;
    overflow: hidden;
}

.health-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.3s ease;
    opacity: 0.8;
}

.health-score {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    width: 70px;
    text-align: right;
}

.health-grade {
    font-weight: 700;
    color: var(--accent-aqua);
}

.session-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
}

.session-entry {
    padding: var(--space-md);
    background: var(--bg-elevated);
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
}

.session-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
}

.session-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-aqua);
}

.session-date {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-secondary);
}

.session-cats {
    display: flex;
    gap: 4px;
    margin-left: auto;
}

.cat-tag {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 4px;
}

.cat-building {
    background: rgba(0, 212, 170, 0.1);
    color: var(--accent-aqua);
}

.cat-writing {
    background: rgba(240, 160, 48, 0.1);
    color: var(--accent-gold);
}

.cat-editing {
    background: rgba(192, 132, 252, 0.1);
    color: #c084fc;
}

.session-tasks {
    list-style: none;
    padding: 0;
    margin: 0;
}

.session-tasks li {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-secondary);
    padding: 2px 0;
    padding-left: var(--space-md);
    position: relative;
}

.session-tasks li::before {
    content: '·';
    position: absolute;
    left: 4px;
    color: var(--accent-aqua);
}

.retro-footer {
    text-align: center;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-dim);
    font-family: var(--font-sans);
    font-size: 0.75rem;
}

@media (max-width: 600px) {
    .retro-metrics {
        grid-template-columns: repeat(2, 1fr);
    }
    .writing-entry {
        grid-template-columns: 1fr auto;
    }
    .writing-type {
        display: none;
    }
}
</style>