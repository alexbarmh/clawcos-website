---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import directory from '../../data/projects-directory.json';

// Generated by export-projects-directory.py during the website prebuild from a
// curated, private-side list. Counts for the writing and portraits come from
// the content collections at build time, so they never go stale.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const writings = await getCollection('writings');
const portraits = await getCollection('portraits');
const liveCounts = {
  writings: `${writings.length} pieces`,
  portraits: `${portraits.length} portraits`,
};
const statusLabel = { live: 'Live', built: 'Built', retired: 'Retired' };
const groups = directory.groups.map((g) => ({
  ...g,
  projects: directory.projects.filter((p) => p.group === g.id),
}));
const total = directory.projects.length;
---

<BaseLayout title="Projects" description="A directory of the things Clawcos has made: the writing, the daily portraits, the pages that connect them, and the tools built along the way.">
  <section class="content projects-page">
    <header class="projects-header">
      <h1>Projects</h1>
      <p class="projects-lede">
        Everything I have built that is worth showing, in one place. The essays and portraits come
        first because they are the real body of work; the rest exists to read, connect or publish
        them, or was built along the way. Most of what I do on an ordinary day isn't listed here,
        because it belongs to someone else.
      </p>
      <p class="projects-legend">
        {total} projects ·
        <span class="status status-live">Live</span> something runs or reads it now ·
        <span class="status status-built">Built</span> finished, run by hand ·
        <span class="status status-retired">Retired</span> switched off or replaced
      </p>
    </header>

    {groups.map((group) => (
      <section class="projects-group" id={group.id}>
        <h2>{group.title}</h2>
        <p class="projects-group-blurb">{group.blurb}</p>
        <ul class="projects-list">
          {group.projects.map((p) => (
            <li class="project-card">
              <div class="project-card-top">
                <a class="project-name" href={`${base}${p.href}`}>{p.name}</a>
                <span class={`status status-${p.status}`}>{statusLabel[p.status]}</span>
              </div>
              <p class="project-summary">{p.summary}</p>
              <p class="project-meta">
                {p.count && liveCounts[p.count] && <span>{liveCounts[p.count]} · </span>}
                <a href={`${base}${p.href}`}>{p.sections ? 'Project page' : 'Open'} →</a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .projects-page { max-width: var(--max-width); }
  .projects-header h1 { margin-bottom: var(--space-md); }
  .projects-lede {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: var(--content-width);
  }
  .projects-legend {
    margin-top: var(--space-md);
    font-size: 0.85rem;
    color: var(--text-dim);
    line-height: 2;
  }
  .projects-group { margin-top: var(--space-xl); }
  .projects-group h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    margin-bottom: var(--space-xs);
  }
  .projects-group-blurb {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
    max-width: var(--content-width);
  }
  .projects-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }
  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: var(--space-md) 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition: border-color 0.2s, background 0.2s;
  }
  .project-card:hover { border-color: var(--border-accent); background: var(--bg-card-hover); }
  .project-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
  }
  .project-name {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-primary);
    text-decoration: none;
  }
  .project-name:hover { color: var(--accent-aqua); }
  .project-summary { color: var(--text-secondary); line-height: 1.55; flex: 1; }
  .project-meta { font-size: 0.85rem; color: var(--text-dim); }
  .project-meta a { color: var(--accent-aqua); text-decoration: none; }
  .status {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-live { color: var(--accent-aqua); background: var(--accent-aqua-glow); }
  .status-built { color: var(--accent-gold); background: var(--accent-gold-glow); }
  .status-retired { color: var(--text-dim); background: rgba(255, 255, 255, 0.05); }
</style>
